# Add to the PAM stacks of your login paths (login, sddm, gdm-password,
# lightdm, sshd). Place the session line after pam_systemd.so.
#
# The module never sends your password anywhere: it reads the collection's
# vault header, derives the key in its own process, and sends only the key.
#
# Module options (append after pam_secret_manager.so, space separated):
#   collection=<id>    vault collection to unlock (default: "default")
#   vault_dir=<path>   absolute directory holding <collection>.vault
#                        (default: <home>/.local/share/secret-manager; set
#                        this when you changed [vault] dir in config.toml)
#   auto_start=no      do not `systemctl --user start` the daemon if its
#                        control socket is not already up
#   socket=<path>      test-only override; ignored when running as root
auth      optional  pam_secret_manager.so
session   optional  pam_secret_manager.so
password  optional  pam_secret_manager.so
