[Unit]
Description=secret-manager Secret Service daemon
Documentation=https://github.com/quinnjr/secret-manager
Conflicts=gnome-keyring-daemon.service
After=graphical-session-pre.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/bin/secret-manager daemon --foreground
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

# Memory-exposure hardening: secrets live only in this process's memory.
#
# This is a *user* unit: it starts with none of root's privileges or kernel
# access to begin with, so several of the directives below restrict things
# an unprivileged user service could never touch anyway (and a few need a
# user namespace some distributions restrict). They are kept because they
# are harmless where supported, but they are defence in depth here, not the
# boundary actually doing the work. The directives actually load-bearing for
# this daemon are: NoNewPrivileges, UMask, RestrictAddressFamilies,
# RuntimeDirectoryMode, MemoryMax, SystemCallFilter,
# SystemCallArchitectures, LimitCORE, and ProtectSystem.
LimitCORE=0
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
RuntimeDirectory=secret-manager
RuntimeDirectoryMode=0700
# Defence in depth only for a user unit (see comment above).
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# The daemon spawns pinentry as a child; unix sockets carry the session bus,
# control socket, and pinentry's Assuan pipe, but glibc/GTK inside pinentry
# also needs AF_NETLINK (device/theme enumeration) to come up correctly.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# The seccomp W^X restriction and the private /dev directive are deliberately
# absent here: both would be inherited by the pinentry child, which needs a
# writable+executable mapping for software-GL/JIT rendering and a real /dev
# (host TTY, DRI nodes) for curses and GUI pinentry to work.
UMask=0077
# Bounds runaway key derivations to the service.
MemoryMax=1G
# Raise this (and set `[vault] lock_memory = true`) to keep secrets out of
# swap; the user session's hard limit caps what a user unit may request.
#LimitMEMLOCK=512M

[Install]
WantedBy=default.target
