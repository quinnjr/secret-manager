[Unit]
Description=secret-manager Secret Service daemon
Documentation=https://github.com/quinnjr/secret-manager
Conflicts=gnome-keyring-daemon.service
After=graphical-session-pre.target

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/bin/secret-manager daemon --foreground
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

# Memory-exposure hardening: secrets live only in this process's memory.
LimitCORE=0
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
# ProtectSystem=strict makes the filesystem read-only; the vault data
# directory and the runtime control socket directory still need writes.
# %h/.config stays readable under strict, so it needs no entry here.
ReadWritePaths=%h/.local/share/secret-manager %t/secret-manager

[Install]
WantedBy=default.target
